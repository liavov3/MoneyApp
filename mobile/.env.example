# Base URL of the MoneySaver backend (FastAPI, mounted at /api/v1).
# Local dev (simulator on the same machine):
EXPO_PUBLIC_API_URL=http://localhost:8000
# Physical device / Android emulator: use your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Enter the backend's access code on the app's connection screen at runtime.
# Never put credentials in EXPO_PUBLIC_* variables: they are bundled into the app.
# Public servers must use HTTPS; HTTP is supported only for local development
# with localhost, loopback, or private LAN IPv4 addresses.
